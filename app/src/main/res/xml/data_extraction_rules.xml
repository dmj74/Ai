<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup / device-transfer rules: keep API keys on the device only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="titanali_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="titanali_settings.xml" />
    </device-transfer>
</data-extraction-rules>
